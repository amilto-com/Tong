// Example demonstrating TONG's support for direct array element update syntax.
// TONG supports arr[i] = v syntax for updating array elements.
// This example shows updating elements in an array using the arr[i] = expr syntax.

fn main() {
  var xs = [0,1,2]
  xs[0] = xs[0] + 10
  xs[2] = xs[1] + xs[2]
  print("updated array", xs[0], xs[1], xs[2])
}

main()
