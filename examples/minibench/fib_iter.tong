let args = import("args")

fn fib_iter(n) {
    if n <= 1 { return n }
    var a = 0
    var b = 1
    var i = 2
    while i <= n {
        let t = a + b
        a = b
        b = t
        i = i + 1
    }
    b
}

fn main() {
    let n = {
        let a = args.get(0)
        let v = args.parse_int(a)
        if v > 0 { v } else { 40 }
    }
    let t0 = now_ms()
    let r = fib_iter(n)
    let t1 = now_ms()
    print("fib_iter(", n, ")=", r, " time_ms=", (t1 - t0))
}

main()
