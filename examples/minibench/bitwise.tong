let args = import("args")

fn main() {
    let n = {
        let a = args.get(0)
        let v = args.parse_int(a)
        if v > 0 { v } else { 2000000 }
    }
    let t0 = now_ms()
    var x = 0
    var i = 0
    while i < n {
        x = ((x << 1) ^ i) & 0x7fffffff
        i = i + 1
    }
    let t1 = now_ms()
    print("bitwise x=", x, " time_ms=", (t1 - t0))
}

main()
