let args = import("args")

fn main() {
    let n = {
        let a = args.get(0)
        let v = args.parse_int(a)
        if v > 0 { v } else { 200000 }
    }
    let t0 = now_ms()
    var a = map(range(n), |i| 0)
    var i = 0
    while i < n {
        a[i] = i
        i = i + 1
    }
    let t1 = now_ms()
    print("array_fill last=", a[n-1], " time_ms=", (t1 - t0))
}

main()
